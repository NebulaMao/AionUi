+/// Resolve the global user CLI-path override (`acp.config[key].cli_path`) from
+/// `client_preferences` — the same value the desktop UI persists via
+/// Settings → Agents.
+///
+/// Mirrors the UI's `getAgentCliPath` key resolution: a row-scoped custom agent
+/// is keyed by its `agent_id`, builtin vendors by `backend`. Tries the agent-id
+/// key first, then the backend key. Returns `None` on any miss (no repo, no
+/// pref, malformed JSON, empty/whitespace path) so the caller falls back to the
+/// `$PATH` binary.
+async fn resolve_global_cli_path(deps: &AgentFactoryDeps, agent_id: Option<&str>, backend: Option<&str>) -> Option<String> {
+    let repo = deps.client_pref_repo.as_ref()?;
+    let prefs = repo.get_by_keys(&["acp.config"]).await.ok()?;
+    let pref = prefs.into_iter().next()?;
+    let parsed: serde_json::Value = serde_json::from_str(&pref.value).ok()?;
+    for key in [agent_id, backend].into_iter().flatten() {
+        if let Some(cli_path) = parsed
+            .get(key)
+            .and_then(|v| v.get("cli_path"))
+            .and_then(|v| v.as_str())
+            .map(str::trim)
+            .filter(|p| !p.is_empty())
+        {
+            return Some(cli_path.to_owned());
+        }
+    }
+    None
+}
